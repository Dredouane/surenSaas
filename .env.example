# SurenSaaS - Variables d'environnement

# ============================================
# SUPABASE (Obligatoire pour les 2 projets)
# ============================================
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=REDACTED_JWT
SUPABASE_ANON_KEY=REDACTED_JWT

# ============================================
# BACKEND (surenSaasBack)
# ============================================
# JWT Secret pour signer les cookies de session (générer avec: openssl rand -hex 32)
JWT_SECRET=votre-jwt-secret-tres-securise-32-caracteres-min

# CORS - Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,https://votre-front.run.app

# Debug mode (true/false)
DEBUG=false

# ============================================
# FRONTEND (surenSaasFront)
# ============================================
# URL du backend
API_URL=http://localhost:8000

# Build ID (pour le force-reload, généré automatiquement en prod)
BUILD_ID=local-dev

# ============================================
# GCP / DEPLOIEMENT
# ============================================
GCP_PROJECT_ID=votre-projet-gcp
GCP_REGION=europe-west1

# Noms des services Cloud Run
FRONT_SERVICE_NAME=surensaas-front
BACK_SERVICE_NAME=surensaas-back

# ============================================
# BASE DE DONNEES (local development only)
# ============================================
# Pour migrations SQL directes
DATABASE_URL=REDACTED_DB_URL
