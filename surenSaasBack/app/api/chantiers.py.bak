from fastapi import APIRouter, HTTPException, Request, Query
from pydantic import BaseModel
from typing import List, Optional
from datetime import datetime

from app.api.auth import get_current_user_from_cookie, get_supabase
from app.core.logging import get_logger

logger = get_logger(__name__)
router = APIRouter(prefix="/chantiers", tags=["chantiers"])


def check_user_org_access(request: Request, org_id: str):
    user = get_current_user_from_cookie(request)
    if user["org_id"] != org_id:
        raise HTTPException(status_code=403, detail="Accès non autorisé à cette organisation")
    return user


# Schemas Pydantic

class ChantierBase(BaseModel):
    nom: str
    description: Optional[str] = None
    adresse: Optional[str] = None
    ville: Optional[str] = None
    code_postal: Optional[str] = None
    statut: Optional[str] = "en_preparation"
    date_debut: Optional[str] = None
    date_fin_prevue: Optional[str] = None
    date_fin_reelle: Optional[str] = None
    client_name: Optional[str] = None
    contact_telephone: Optional[str] = None
    contact_email: Optional[str] = None
    montant_initial: Optional[float] = 0
    montant_revise: Optional[float] = 0
    montant_facture: Optional[float] = 0
    montant_depenses: Optional[float] = 0
    marge_estimee: Optional[float] = 0
    solde_restant: Optional[float] = 0
    responsable_nom: Optional[str] = None
    responsable_telephone: Optional[str] = None
    responsable_email: Optional[str] = None
    notes_internes: Optional[str] = None
    priorite: Optional[str] = "normale"
    tags: Optional[List[str]] = None

class ChantierCreate(ChantierBase):
    pass

class ChantierUpdate(BaseModel):
    nom: Optional[str] = None
    description: Optional[str] = None
    adresse: Optional[str] = None
    ville: Optional[str] = None
    code_postal: Optional[str] = None
    statut: Optional[str] = None
    date_debut: Optional[str] = None
    date_fin_prevue: Optional[str] = None
    date_fin_reelle: Optional[str] = None
    client_name: Optional[str] = None
    contact_telephone: Optional[str] = None
    contact_email: Optional[str] = None
    montant_initial: Optional[float] = None
    montant_revise: Optional[float] = None
    montant_facture: Optional[float] = None
    responsable_nom: Optional[str] = None
    responsable_telephone: Optional[str] = None
    responsable_email: Optional[str] = None
    notes_internes: Optional[str] = None
    priorite: Optional[str] = None
    tags: Optional[List[str]] = None

class ChantierResponse(ChantierBase):
    id: str
    org_id: str
    created_at: str
    updated_at: Optional[str] = None

    class Config:
        from_attributes = True


