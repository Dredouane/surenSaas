        print_warning("ignoré")
        return True

    cookies = {"session_token": auth["session_token"]}
    org_id = auth["org_id"]

    payload = {
        "date": datetime.utcnow().strftime("%Y-%m-%d"),
        "numero": 999,
        "libelle": "Situation test CRUD",
        "montant": 1000.00,
    }
    response = client.post(
        f"/api/v1/chantiers/{EXISTING_REF}/situations?org_id={org_id}",
        json=payload,
        cookies=cookies,
    )
    if response.status_code not in (200, 201):
        print_error(f"HTTP {response.status_code}: {response.text[:200]}")
        return False

    data = response.json()
    print_success(f"OK — id={data.get('id', '?')[:8]}...")

    supabase = get_supabase()
    try:
        supabase.table("chantier_situations").delete().eq(
            "id", data.get("id")
        ).execute()
    except Exception:
        pass

    from app.api.auth import get_supabase
    return True


