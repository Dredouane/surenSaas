def test_full_create_update_delete_chantier():
    """Test complet: POST → GET → PUT → DELETE d'un chantier par ref."""
    print_header("Cycle CRUD complet chantier")
    auth = get_auth_session()
    if not auth:
        print_warning("ignoré")
        return True

    from app.api.auth import get_supabase

    supabase = get_supabase()
    cookies = {"session_token": auth["session_token"]}
    org_id = auth["org_id"]

    user_id = (
        supabase.table("users")
        .select("id")
        .eq("email", TEST_LOGIN)
        .single()
        .execute()
        .data["id"]
    )

    # 1. Créer un chantier de test
    print("1. POST create chantier...")
    test_ref = TEST_REF
    test_uuid, _ = setup_test_chantier(supabase, org_id, user_id)
    print_success(f"Créé avec id={test_uuid[:8]}..., ref={test_ref}")

    try:
        # 2. GET par ref
        print("2. GET par ref...")
        r = client.get(
            f"/api/v1/chantiers/{test_ref}?org_id={org_id}", cookies=cookies
        )
        if r.status_code != 200:
            print_error(f"GET par ref: HTTP {r.status_code}")
            return False
        assert r.json()["ref"] == test_ref, "ref mismatch"
        print_success("OK")

        # 3. GET par UUID
        print("3. GET par UUID...")
        r = client.get(
            f"/api/v1/chantiers/{test_uuid}?org_id={org_id}", cookies=cookies
        )
        if r.status_code != 200:
            print_error(f"GET par UUID: HTTP {r.status_code}")
            return False
        assert r.json()["id"] == test_uuid, "id mismatch"
        print_success("OK")

        # 4. PUT (update) par ref
        print("4. PUT update par ref...")
        r = client.put(
            f"/api/v1/chantiers/{test_ref}?org_id={org_id}",
            json={"nom": "Nom modifié via test", "commentaires": "Test update"},
            cookies=cookies,
        )
        if r.status_code != 200:
            print_error(f"PUT: HTTP {r.status_code}: {r.text[:200]}")
            return False
        assert r.json()["nom"] == "Nom modifié via test", "nom not updated"
        print_success("OK")

        # 5. DELETE par UUID
        print("5. DELETE par UUID...")
        r = client.delete(
            f"/api/v1/chantiers/{test_uuid}?org_id={org_id}", cookies=cookies
        )
        if r.status_code != 200:
            print_error(f"DELETE: HTTP {r.status_code}: {r.text[:200]}")
            return False
        print_success("OK")

        # 6. Vérifier 404 après suppression
        print("6. Vérification 404 après delete...")
        r = client.get(
            f"/api/v1/chantiers/{test_uuid}?org_id={org_id}", cookies=cookies
        )
        if r.status_code != 404:
            print_error(f"Attendu 404, reçu {r.status_code}")
            return False
        print_success("OK")

        return True

    finally:
        teardown_test_chantier(supabase, test_uuid)


# ============================================================================
# MAIN
# ============================================================================

if __name__ == "__main__":
    print_header("TESTS INTÉGRATION CHANTIERS CRUD")

    tests = [
        ("GET by ref", test_get_chantier_by_ref),
        ("GET by UUID", test_get_chantier_by_uuid),
        ("GET 404 inexistant", test_get_chantier_404),
        ("GET situations", test_list_situations),
        ("GET depenses", test_list_depenses),
        ("GET operations", test_list_operations),
        ("GET receptions", test_list_receptions),
        ("GET taches", test_list_taches),
        ("GET ressources", test_list_ressources),
        ("GET pointages", test_list_pointages),
        ("GET notifications", test_list_notifications),
        ("POST situation", test_create_situation),
        ("POST depense", test_create_depense),
        ("POST operation", test_create_operation),
        ("POST tache", test_create_tache),
        ("POST pointage", test_create_pointage),
        ("POST notification", test_create_notification),
        ("POST ressource", test_create_ressource),
        ("Cycle CRUD complet", test_full_create_update_delete_chantier),
    ]

    results = []
    for name, fn in tests:
        try:
            ok = fn()
        except Exception as e:
            print_error(f"{name}: {e}")
            import traceback

            traceback.print_exc()
            ok = False
        results.append((name, ok))

    print_header("RÉSUMÉ")
    passed = sum(1 for _, ok in results if ok)
    for name, ok in results:
        (print_success if ok else print_error)(name)

    print(f"\n{Colors.BLUE}Total: {passed}/{len(tests)} test(s) réussi(s){Colors.RESET}")
    sys.exit(0 if passed == len(tests) else 1)
