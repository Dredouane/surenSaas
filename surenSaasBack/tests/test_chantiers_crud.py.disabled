def test_get_chantier_404():
    """GET /chantiers/{inexistant} → 404."""
    print_header("GET chantier inexistant → 404")
    auth = get_auth_session()
    if not auth:
        print_warning("ignoré")
        return True

    cookies = {"session_token": auth["session_token"]}
    org_id = auth["org_id"]

    fake_ref = f"__inexistant_{datetime.utcnow().timestamp()}__"
    response = client.get(
        f"/api/v1/chantiers/{fake_ref}?org_id={org_id}", cookies=cookies
    )
    if response.status_code != 404:
        print_error(f"Attendu 404, reçu {response.status_code}")
        return False

    print_success("OK — 404 correctement retourné")
    return True


