# ============================================
# ENVIRONNEMENT TEST - TEMPLATE
# ============================================
# ⚠️  IMPORTANT: Ce fichier est un TEMPLATE
# ⚠️  Les secrets doivent être dans ~/.bashrc ou GCP Secret Manager
# ⚠️  NE JAMAIS COMMITTER LES VRAIES VALEURS
#
# Pour configurer localement:
# 1. Copier ce fichier: cp .env.test.example .env.test
# 2. Les secrets sont lus depuis ~/.bashrc (TEST_JWT_SECRET, etc.)
# 3. Ou définissez-les temporairement: export TEST_JWT_SECRET=xxx

ENVIRONMENT=test

# ============================================
# SUPABASE (partagé - pas secret)
# ============================================
SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_KEY est dans ~/.bashrc ou GCP Secrets

# ============================================
# ORGANISATION TEST
# ============================================
TEST_ORG_ID=<your-org-uuid>
TEST_ORG_SLUG=REDACTED_ORG_SLUG
TEST_ORG_NAME="Suren - TEST"

# ============================================
# BACKEND TEST - SECRETS DANS ~/.bashrc
# ============================================
# TEST_JWT_SECRET doit être défini dans ~/.bashrc

# CORS - Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,https://test-surensaas-front-xxx.run.app

DEBUG=true

# ============================================
# FRONTEND TEST
# ============================================
API_URL=https://test-surensaas-back-REDACTED-ew.a.run.app
BUILD_ID=test

# ============================================
# GCP / DEPLOIEMENT TEST
# ============================================
GCP_PROJECT_ID=suren-saas
GCP_REGION=europe-west1
TEST_FRONT_SERVICE_NAME=test-surensaas-front
TEST_BACK_SERVICE_NAME=test-surensaas-back
