# ============================================
# ENVIRONNEMENT PRODUCTION - TEMPLATE
# ============================================
# ⚠️  IMPORTANT: Ce fichier est un TEMPLATE
# ⚠️  Les secrets doivent être dans ~/.bashrc ou GCP Secret Manager
# ⚠️  NE JAMAIS COMMITTER LES VRAIES VALEURS
#
# Pour configurer localement:
# 1. Copier ce fichier: cp .env.prod.example .env.prod
# 2. Les secrets sont lus depuis ~/.bashrc (PROD_JWT_SECRET, etc.)
# 3. Ou définissez-les temporairement: export PROD_JWT_SECRET=xxx

ENVIRONMENT=production

# ============================================
# SUPABASE (partagé - pas secret)
# ============================================
SUPABASE_URL=https://REDACTED.supabase.co
# PROD_SUPABASE_SERVICE_KEY est dans ~/.bashrc ou GCP Secrets

# ============================================
# ORGANISATION PRODUCTION
# ============================================
PROD_ORG_ID=uuid-organisation-prod
PROD_ORG_SLUG=ma-societe
PROD_ORG_NAME="Ma Société"

# ============================================
# BACKEND PRODUCTION - SECRETS DANS ~/.bashrc
# ============================================
# ⚠️ ATTENTION: JWT Secret PROD doit être DIFFERENT de TEST
# PROD_JWT_SECRET doit être défini dans ~/.bashrc

# CORS - Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=https://app-votredomaine.com

DEBUG=false

# ============================================
# FRONTEND PRODUCTION
# ============================================
API_URL=https://api-votredomaine.com
BUILD_ID=prod

# ============================================
# GCP / DEPLOIEMENT PRODUCTION
# ============================================
GCP_PROJECT_ID=suren-saas
GCP_REGION=europe-west1
PROD_FRONT_SERVICE_NAME=surensaas-front
PROD_BACK_SERVICE_NAME=surensaas-back
