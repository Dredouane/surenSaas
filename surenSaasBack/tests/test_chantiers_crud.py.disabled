#!/usr/bin/env python3
"""
Tests d'intégration pour les endpoints chantiers CRUD.
Utilise la base réelle. Nécessite SUREN_TEST_LOGIN et SUREN_TEST_PASSWORD.
"""

import sys
import os
import uuid as _uuid
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from starlette.testclient import TestClient
from app.main import app

client = TestClient(app)



TEST_ORG_ID = "REDACTEDORG"
TEST_LOGIN = os.getenv("SUREN_TEST_LOGIN")
TEST_PASSWORD = os.getenv("SUREN_TEST_PASSWORD")

EXISTING_REF = "CRF"
EXISTING_UUID = "d02e9843-a3a5-46f3-a2d2-5a9bc9c31fb5"
TEST_REF = f"__test_chantier_{datetime.utcnow().strftime('%Y%m%d%H%M%S')}__"


class Colors:
    GREEN = "\033[92m"
    RED = "\033[91m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    RESET = "\033[0m"


def print_header(title):
    print(f"\n{Colors.BLUE}{'=' * 60}{Colors.RESET}")
    print(f"{Colors.BLUE}{title.center(60)}{Colors.RESET}")
    print(f"{Colors.BLUE}{'=' * 60}{Colors.RESET}\n")


def print_success(msg):
    print(f"{Colors.GREEN}  PASS  {msg}{Colors.RESET}")


def print_error(msg):
    print(f"{Colors.RED}  FAIL  {msg}{Colors.RESET}")


def print_warning(msg):
    print(f"{Colors.YELLOW}  SKIP  {msg}{Colors.RESET}")


_AUTH_CACHE = None


def get_auth_session(force=False):
    """Authentifie et retourne cookies + org_id (avec cache global)."""
    global _AUTH_CACHE
    if _AUTH_CACHE is not None and not force:
        return _AUTH_CACHE

    if not TEST_LOGIN:
        print_warning("SUREN_TEST_LOGIN non défini")
        _AUTH_CACHE = None
        return None

    try:
        response = client.post("/api/v1/auth/check-email", json={"email": TEST_LOGIN})
        if response.status_code != 200:
            print_warning(f"check-email: {response.status_code}")
            _AUTH_CACHE = None
            return None

        check_data = response.json()
        if not check_data.get("authorized"):
            print_warning("Email non autorisé")
            _AUTH_CACHE = None
            return None

        org_id = check_data.get("org_id")

        if TEST_PASSWORD:
            response = client.post(
                "/api/v1/auth/login",
                json={"email": TEST_LOGIN, "password": TEST_PASSWORD},
            )
            if response.status_code == 200:
                session_token = response.cookies.get("session_token")
                if session_token:
                    _AUTH_CACHE = {"session_token": session_token, "org_id": org_id}
                    return _AUTH_CACHE

        from app.api.auth import get_supabase, create_session_token

        supabase = get_supabase()
        user_result = (
            supabase.table("users")
            .select("id")
            .eq("email", TEST_LOGIN)
            .single()
            .execute()
        )
        if not user_result.data:
            print_warning(f"Utilisateur {TEST_LOGIN} non trouvé en DB")
            _AUTH_CACHE = None
            return None

        user_id = user_result.data["id"]
        org_slug = ""
        try:
            org_result = (
                supabase.table("organizations")
                .select("slug")
                .eq("id", org_id)
                .single()
                .execute()
            )
            if org_result.data:
                org_slug = org_result.data.get("slug", "")
        except Exception:
            pass

        token = create_session_token(
            user_id=user_id,
            email=TEST_LOGIN,
            org_id=org_id,
            org_slug=org_slug,
            role="admin",
        )
        if token:
            _AUTH_CACHE = {"session_token": token, "org_id": org_id}
            return _AUTH_CACHE

        _AUTH_CACHE = None
        return None

    except Exception as e:
        print_warning(f"Auth échouée: {e}")
        _AUTH_CACHE = None
        return None


def setup_test_chantier(supabase, org_id, user_id):
    """Crée un chantier de test temporaire et retourne son id + ref."""
    data = {
        "org_id": org_id,
        "ref": TEST_REF,
        "nom": "Chantier de test CRUD",
        "adresse": "42 Rue du Test, 75000 Paris",
        "conducteur": "Test Conducteur",
        "montant_base": 100000.00,
        "statut": "en_cours",
        "priorite": 1,
        "created_by": user_id,
        "created_at": datetime.utcnow().isoformat(),
    }
    result = supabase.table("chantiers").insert(data).execute()
    if not result.data:
        raise RuntimeError("Impossible de créer le chantier de test")
    return result.data[0]["id"], TEST_REF


def teardown_test_chantier(supabase, chantier_id):
    """Supprime le chantier de test et ses enfants."""
    for table in [
        "chantier_notifications",
        "chantier_pointage_ressources",
        "chantier_pointages",
        "chantier_situations",
        "chantier_depenses",
        "chantier_operations_htl",
        "chantier_receptions",
        "chantier_taches",
        "chantier_ressources",
    ]:
        try:
            supabase.table(table).delete().eq("chantier_id", chantier_id).execute()
        except Exception:
            pass
    supabase.table("chantiers").delete().eq("id", chantier_id).execute()


# ============================================================================
# TESTS
# ============================================================================


def test_get_chantier_by_ref():
    """GET /chantiers/{ref} → 200, retourne le bon chantier."""
    print_header("GET chantier par ref")
    auth = get_auth_session()
    if not auth:
        print_warning("ignoré")
        return True

    cookies = {"session_token": auth["session_token"]}
    org_id = auth["org_id"]

    response = client.get(
        f"/api/v1/chantiers/{EXISTING_REF}?org_id={org_id}", cookies=cookies
    )
    if response.status_code != 200:
        print_error(f"HTTP {response.status_code}: {response.text[:100]}")
        return False

    data = response.json()
    if data.get("ref") != EXISTING_REF:
        print_error(f"ref attendu={EXISTING_REF}, reçu={data.get('ref')}")
        return False

    print_success(f"OK — ref={data['ref']}, nom={data.get('nom')}")
    return True


